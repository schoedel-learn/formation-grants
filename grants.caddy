# grants.educatebarry.co — public boss table (noindex). Owner direction
# 2026-10-23: available to anyone at the root; deliberately NOT indexed by
# search engines (X-Robots-Tag + robots.txt disallow). root path = container
# view of the matrix_caddy_data volume (host:
# /var/lib/docker/volumes/matrix_caddy_data/_data).
#
# Heredoc rules learned on deploy: the marker must end the line EXACTLY (no
# trailing space) or the heredoc never opens; the body precedes the status;
# the closing marker line carries the status token.
grants.educatebarry.co {
    header X-Robots-Tag "noindex, nofollow"
    respond /robots.txt <<ROBOTSTXT
User-agent: *
Disallow: /
ROBOTSTXT 200
    root * /data/sites/grants.educatebarry.co
    file_server
}